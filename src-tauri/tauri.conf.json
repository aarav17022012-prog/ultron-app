{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ULTRON",
  "version": "1.1.23",
  "identifier": "com.ultron.notch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ULTRON",
        "width": 1536,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion,MediaRouter,OptimizationHints,AutofillServerCommunication,Translate --disable-background-networking --disable-component-update --disable-domain-reliability --no-pings --autoplay-policy=no-user-gesture-required --auto-select-desktop-capture-source=creen"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/ggml-small.en-q5_1.bin": "resources/models/ggml-small.en-q5_1.bin",
      "resources/piper/": "resources/piper/",
      "resources/voices/": "resources/voices/",
      "resources/llama/": "resources/llama/",
      "resources/models/Kim_Vocal_2.onnx": "resources/models/Kim_Vocal_2.onnx",
      "resources/screen/": "resources/screen/"
    },
    "windows": {
      "nsis": {
        "compression": "none",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
